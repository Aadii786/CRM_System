########################################
# University CRM & Marketing Platform
# Environment configuration example
#
# Copy this file to .env.local and fill in
# real values. NEVER commit .env.local.
########################################

# --- Database (MySQL via Sequelize) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crm_platform
DB_USER=root
DB_PASSWORD=your_database_password
DB_DIALECT=mysql

# --- App / Session ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Random 32+ char secret used to sign session (JWT) cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# --- Seeded default administrator ---
# Used only by `npm run db:seed` to create the initial admin account.
DEFAULT_ADMIN_EMAIL=admin@university.edu.pk
DEFAULT_ADMIN_PASSWORD=change-this-password

# --- Demo users password ---
# All seeded demo users (Rector, Marketing, IKL/HSM, etc.) share this
# password for demo purposes only. Change/remove before any real deployment.
DEMO_USER_PASSWORD=Demo@12345

# --- Seed data scale ---
# Number of demo contacts generated by `npm run db:seed`.
# Fresh start: a small demo set (the old 58,000-contact demo data was dropped).
SEED_CONTACT_COUNT=500

# --- Automated overdue-task reminders (requirements: automated
# reminders/notifications for pending follow-ups and overdue activities) ---
# Runs opportunistically whenever the app is used either way; set this and
# deploy to Vercel (see vercel.json) for genuine 24/7 automation regardless
# of whether anyone is logged in. Leave blank locally - the endpoint stays
# open for easy manual testing (curl http://localhost:3000/api/cron/reminders)
# when unset.
CRON_SECRET=

# --- Campaign email delivery (see docs/email-delivery.md) ---
# "simulated" (default) sends nothing: demo mode. Set to the real provider
# once IT decides (mailchimp | ses) and its driver is implemented in
# src/lib/email/provider.js.
EMAIL_PROVIDER=simulated
# Public address of the CRM. Tracking links and the unsubscribe link in every
# email are built from APP_URL, so it must be the address recipients can reach.
# Bearer secret the email provider sends to POST /api/email/webhook.
EMAIL_WEBHOOK_SECRET=
# Optional: separate secret for signing email links (falls back to SESSION_SECRET).
EMAIL_LINK_SECRET=
# The scheduler (/api/cron/campaigns, every 5 minutes, see vercel.json) is
# protected by CRON_SECRET above. Locally: curl http://localhost:3000/api/cron/campaigns

# --- Optional integrations (demo/mock unless configured) ---
# Leaving these unset keeps the corresponding Integrations card in
# "Not connected" demo mode - no external calls are ever made either way
# unless these are explicitly wired up in lib/services.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
WHATSAPP_PROVIDER_API_KEY=
